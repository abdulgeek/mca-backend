# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
MONGODB_URI=

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# PIN Authentication Configuration
# 4-digit PIN required to access the application
ACCESS_PIN=1234

# Cloudinary Configuration (Required for image storage)
# Get these from your Cloudinary Dashboard -> Settings -> API Keys
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_SECRET_KEY=your-api-secret