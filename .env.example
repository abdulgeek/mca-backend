# CostKatana Configuration
# Get your API key from https://costkatana.com/dashboard
COSTKATANA_API_KEY=dak_your_key_here

# Default AI model for cost calculations
# Options: amazon.nova-lite-v1:0, gpt-3.5-turbo, gpt-4, claude-3-sonnet, etc.
COSTKATANA_DEFAULT_MODEL=amazon.nova-lite-v1:0

# Enable/disable cost tracking (true/false)
COSTKATANA_ENABLE_TRACKING=true

# Enable/disable Cortex optimization (true/false)
COSTKATANA_ENABLE_OPTIMIZATION=true

# Maximum cost per request in USD
COSTKATANA_MAX_COST_PER_REQUEST=1.0

# Optimization level: aggressive, balanced, quality
COSTKATANA_OPTIMIZATION_LEVEL=balanced

# Logging level: debug, info, warn, error
COSTKATANA_LOG_LEVEL=info

# Existing environment variables
NODE_ENV=development
PORT=3000