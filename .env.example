# CostKatana Configuration
# Get your API key from https://costkatana.com/dashboard
COSTKATANA_API_KEY=dak_your_key_here

# Default model for cost calculations
# Examples: gpt-4, gpt-3.5-turbo, claude-3-opus, amazon.nova-lite-v1:0
COSTKATANA_DEFAULT_MODEL=amazon.nova-lite-v1:0

# Enable automatic cost tracking via middleware (true/false)
COSTKATANA_AUTO_TRACK=false

# Enable debug logging for CostKatana (true/false)
COSTKATANA_DEBUG=false

# Maximum allowed cost per request in USD
COSTKATANA_MAX_COST_PER_REQUEST=1.0

# Alert threshold for total spending in USD
COSTKATANA_ALERT_THRESHOLD=10.0

# [PRESERVE ANY EXISTING ENVIRONMENT VARIABLES BELOW]